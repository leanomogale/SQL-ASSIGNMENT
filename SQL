-- Sizwe Coffee SQL Assignment (Databricks SQL)
-- Task 1: Channel performance
WITH rev AS (
  SELECT o.channel,CASE
      WHEN o.order_date <= DATE '2024-06-30' THEN 'FY2024'
      ELSE 'FY2025'
    END AS fy,
    SUM(l.line_revenue) AS revenue
  FROM sales_orders o
      JOIN sales_lines l
        ON l.order_id = o.order_id
  GROUP BY 1,2
)
SELECT channel,
  ROUND(SUM(revenue) FILTER ( WHERE fy = 'FY2024' ) / 1000000.0, 1) AS fy2024_revenue_m,
  ROUND(SUM(revenue) FILTER ( WHERE fy = 'FY2025' ) / 1000000.0, 1) AS fy2025_revenue_m,
  ROUND(100.0* (SUM(revenue)FILTER ( WHERE fy = 'FY2025' )- SUM(revenue)
  FILTER ( WHERE fy = 'FY2024' ))/ SUM(revenue)FILTER ( WHERE fy = 'FY2024' ),1) 
  AS growth_pct
FROM rev 
  GROUP BY channel 
  ORDER BY channel;

-- Answer:
-- Subscription: R132.8M -> R144.6M (+8.8%)
--Wholesale: R308.2M -> R335.4M (+8.8%)
-- Both channels grew ~8.8%; Subscription is ~30% of revenue

-- Task 2: Where the profit actually comes from
SELECT
  p.product_line,
  ROUND(SUM(l.line_revenue) / 1000000.0, 1) AS revenue_m,
  ROUND(SUM(l.cogs) / 1000000.0, 1) AS cost_of_goods_m,
  ROUND((SUM(l.line_revenue) - SUM(l.cogs)) / 1000000.0, 1) AS gross_profit_m,
  ROUND(100.0 * (SUM(l.line_revenue) - SUM(l.cogs)) / SUM(l.line_revenue), 1) AS gross_margin_pct
FROM sales_lines l
    JOIN products p
    ON p.sku = l.sku
GROUP BY p.product_line
ORDER BY gross_profit_m DESC;

-- Answer:
-- House Blend is the biggest profit line: R107.1M gross profit on R279.5M revenue (38.3% margin)
-- Single Origin has the highest margin (44.3%, R75.3M profit); Bulk Commercial is the weakest (19.9% on R271.8M)

-- Task 3: The collections problem
SELECT
  c.channel,
  COUNT(*) AS invoices,
  COUNT(*)
    FILTER ( WHERE a.settlement_date IS NOT NULL ) AS settled,
  COUNT(*)
    FILTER ( WHERE a.settlement_date IS NULL ) AS still_open,
  ROUND(AVG(DATEDIFF(a.settlement_date, a.invoice_date)), 1) AS avg_days_to_settle,
  ROUND(SUM(a.invoice_amount - COALESCE(a.amount_settled, 0)) / 1000000.0, 2) AS outstanding_value_m
FROM ar_ledger a
    JOIN customers c
    ON c.customer_id = a.customer_id
GROUP BY c.channel
ORDER BY c.channel;
-- Answer:
-- Subscription: 19200 invoices, 19156 settled, 44 open, avg 3.8 days, R751k outstanding
-- Wholesale: 28944 invoices, 25490 settled, 3454 open, avg 68.7 days, R87.8M outstanding
-- Wholesale is the collections problem: 12% still open and R87.8M tied up vs 0.2% / R0.75M for Subscription


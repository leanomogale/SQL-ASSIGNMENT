-- Task 6: Are the sales representatives hitting target?
WITH rep_rev AS (
    SELECT o.rep_id, SUM(l.line_revenue) AS fy2025_revenue
    FROM sales_orders o
JOIN sales_lines l ON l.order_id = o.order_id
    WHERE o.order_date > DATE '2024-06-30'
    GROUP BY o.rep_id
    )
SELECT r.rep_name, r.territory, r.target_monthly,
       ROUND(COALESCE(v.fy2025_revenue, 0) / 12.0, 0) AS fy2025_monthly_avg,
       ROUND(100.0 * COALESCE(v.fy2025_revenue, 0) / 12.0 / r.target_monthly, 1) AS pct_of_target
    FROM reps r
    LEFT JOIN rep_rev v ON v.rep_id = r.rep_id      
    ORDER BY pct_of_target DESC;
-- Answer:
-- 16 of 18 reps are at or above target; best is Karabo van Wyk at 250.3%, worst is Johan Naidoo at 77.6%
-- Sipho Steyn (98.0%) is the only other rep below target; top performers exceed target by 2x+, so targets look stale

-- Task 7: The shape of the year
WITH monthly AS (
    SELECT CAST(DATE_TRUNC('month', o.order_date) AS DATE) AS month,
           SUM(l.line_revenue) AS revenue
    FROM sales_orders o
    JOIN sales_lines l ON l.order_id = o.order_id
    GROUP BY 1
)
SELECT month, revenue,
       ROUND(100.0 * (revenue - LAG(revenue) OVER (ORDER BY month)) / LAG(revenue) OVER (ORDER BY month), 1) AS mom_change_pct,
       ROUND(AVG(revenue) OVER (ORDER BY month 
       ROWS BETWEEN 2 PRECEDING AND CURRENT ROW), 0) AS rolling_3m_avg
FROM monthly
ORDER BY month;
-- Answer: seasonal pattern repeats in both years with revenue falling from july to a low in december, then recovering through to june.

-- Task 8: Why has the margin moved?
WITH pl AS (
    SELECT CASE WHEN o.order_date <= DATE '2024-06-30' THEN 'FY2024' ELSE 'FY2025' END AS fy,
           p.product_line,
           SUM(l.line_revenue)  AS revenue,
           SUM(l.cogs) AS cogs
    FROM sales_orders o
    JOIN sales_lines l ON l.order_id = o.order_id
    JOIN products p ON p.sku = l.sku
    GROUP BY 1, 2
)
SELECT fy, product_line, revenue,
       ROUND(100.0 * (revenue - cogs) / revenue, 1) AS gross_margin_pct,
       ROUND(100.0 * revenue / SUM(revenue) OVER (PARTITION BY fy), 1) AS revenue_share_pct
FROM pl
ORDER BY product_line, fy;
-- Answer: mix shift, not within-line margin change
-- Within-line margins are flat FY2024->FY2025 (Bulk Commercial 19.9%->19.9%, Single Origin 44.2->44.3%)
-- Low-margin Bulk Commercial (19.9%) grew revenue share 25.0%->33.6% while House Blend fell 32.1->28.7%
-- and Single Origin 19.5->17.6%, dragging the blended margin from ~34.7% down to ~33.0%
